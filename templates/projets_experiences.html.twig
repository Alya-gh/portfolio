{% extends 'base.html.twig' %}

{% block body %}

<link rel="stylesheet" href="{{ asset('style.css') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>

/* ================== GLOBAL ================== */

body{
    background:#0b0b0b;
    color:white;
    font-family: Arial, sans-serif;
}

.section-title{
    text-align:center;
    margin-top:60px;
}

.nice-bar{
    width:260px;
    height:2px;
    background:#d59bf6;
    margin:8px auto 50px auto;
}

/* ================== COMPETENCES ================== */

.skills-wrapper{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:40px;
    margin-top:60px;
}

/* CARD */

.skill-card{
    width:300px;
    background:#111;
    border-radius:20px;
    border:1px solid #333;
    padding:20px;
}

/* TITRE CLICKABLE */

.skill-title{
    display:block;
    text-align:center;
    cursor:pointer;
}

.skill-title:hover{
    color:#d59bf6;
}

/* CACHE INPUT */

.skill-toggle{
    display:none;
}

/* AC LIST */

.ac-list{
    display:none;
    margin-top:15px;
}

/* SHOW AC LIST */

.skill-toggle:checked + .skill-title + .ac-list{
    display:block;
}

/* AC ITEM */

.ac-item{
    background:#1a1a1a;
    padding:12px;
    border-radius:12px;
    margin-bottom:10px;
}

/* SEMESTRE */

.sem-panel{
    display:none;
    margin-top:10px;
    text-align:center;
}

.ac-toggle{
    display:none;
}

.ac-toggle:checked + label + .sem-panel{
    display:block;
}

/* LABEL AC */

.ac-label{
    cursor:pointer;
    display:block;
    color:white;
}

.ac-label:hover{
    color:#d59bf6;
}

/* BOUTONS */

.sem-btn{
    margin:5px;
    padding:6px 10px;
    border-radius:8px;
    border:none;
    cursor:pointer;
    background:#d59bf6;
    color:black;
    font-weight:500;
}

.sem-btn:hover{
    opacity:0.8;
}

/* ================== EXPERIENCE ================== */

.experience-container{
    display:flex;
    justify-content:center;
    gap:80px;
    align-items:flex-start;
    margin-top:60px;
    flex-wrap:wrap;
}

.exp-item{
    display:flex;
    gap:15px;
    margin-bottom:25px;
}

.exp-check{
    width:35px;
    height:35px;
    border-radius:50%;
    background:#d59bf6;
    display:flex;
    justify-content:center;
    align-items:center;
}

.exp-box{
    background:#1a1a1a;
    padding:15px 20px;
    border-radius:15px;
    width:300px;
}

.cv img{
    width:320px;
    border-radius:12px;
}

</style>

<!-- ================== TITRE ================== -->

<h1 class="section-title">PROJETS - COMPÉTENCES</h1>
<div class="nice-bar"></div>

<!-- ================== COMPETENCES ================== -->

<div class="skills-wrapper">

<!-- RT1 -->
<div class="skill-card">

    <input type="checkbox" id="rt1" class="skill-toggle">

    <label for="rt1" class="skill-title">
        <h3>RT1</h3>
        <p>Administrer les réseaux</p>
    </label>

    <div class="ac-list">

        <div class="ac-item">

            <input type="checkbox" id="rt1_ac1" class="ac-toggle">

            <label for="rt1_ac1" class="ac-label">
                AC11.01 - Électricité réseau
            </label>

            <div class="sem-panel">
                <a href="{{ asset('Documents/R1.01b.pdf') }}" target="_blank">
                    <button class="sem-btn">S1</button>
                </a>
                <a href="{{ asset('Documents/R2.05.pdf') }}" target="_blank">
                    <button class="sem-btn">S2</button>
                </a>
            </div>

        </div>

    </div>
</div>

<!-- RT2 -->
<div class="skill-card">

    <input type="checkbox" id="rt2" class="skill-toggle">

    <label for="rt2" class="skill-title">
        <h3>RT2</h3>
        <p>Connecter les usagers</p>
    </label>

    <div class="ac-list">

        <div class="ac-item">

            <input type="checkbox" id="rt2_ac1" class="ac-toggle">

            <label for="rt2_ac1" class="ac-label">
                AC12.01 - Analyse signaux
            </label>

            <div class="sem-panel">
                <a href="{{ asset('Documents/SAE1.03.pdf') }}" target="_blank">
                    <button class="sem-btn">S1</button>
                </a>
                <a href="{{ asset('Documents/SAE2.03.pdf') }}" target="_blank">
                    <button class="sem-btn">S2</button>
                </a>
            </div>

        </div>

    </div>
</div>

<!-- RT3 -->
<div class="skill-card">

    <input type="checkbox" id="rt3" class="skill-toggle">

    <label for="rt3" class="skill-title">
        <h3>RT3</h3>
        <p>Développement</p>
    </label>

    <div class="ac-list">

        <div class="ac-item">

            <input type="checkbox" id="rt3_ac1" class="ac-toggle">

            <label for="rt3_ac1" class="ac-label">
                AC13.01 - Programmation
            </label>

            <div class="sem-panel">
                <a href="{{ asset('Documents/R1.07.pdf') }}" target="_blank">
                    <button class="sem-btn">S1</button>
                </a>
                <a href="{{ asset('Documents/R2.07.pdf') }}" target="_blank">
                    <button class="sem-btn">S2</button>
                </a>
            </div>

        </div>

    </div>
</div>

</div>

<!-- ================== EXPERIENCE ================== -->

<h1 class="section-title">EXPÉRIENCE</h1>
<div class="nice-bar"></div>

<div class="experience-container">

    <div>

        <div class="exp-item">
            <div class="exp-check"><i class="bi bi-check-lg"></i></div>
            <div class="exp-box">
                Epsilon — Chef de projet digital (2022)
            </div>
        </div>

        <div class="exp-item">
            <div class="exp-check"><i class="bi bi-check-lg"></i></div>
            <div class="exp-box">
                Mairie de Bobigny — Événementiel (2023)
            </div>
        </div>

        <div class="exp-item">
            <div class="exp-check"><i class="bi bi-check-lg"></i></div>
            <div class="exp-box">
                Orange — Alternance Back Office
            </div>
        </div>

    </div>

    <div class="cv">
        <img src="{{ asset('images/cv.jpg') }}" alt="CV">
    </div>

</div>

{% endblock %}
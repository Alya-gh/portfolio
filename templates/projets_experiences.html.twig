{% extends 'base.html.twig' %}

{% block body %}

<link rel="stylesheet" href="{{ asset('style.css') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>

/* ================= GLOBAL ================= */

body{
    background:#0b0b0b;
    color:white;
    font-family: Arial, sans-serif;
}

.section-title{
    text-align:center;
    margin-top:60px;
    font-weight:600;
    letter-spacing:1px;
}

.nice-bar{
    width:260px;
    height:2px;
    background:#d59bf6;
    margin:8px auto 50px auto;
}

/* ================= WRAPPER ================= */

.skills-wrapper{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:40px;
    margin-top:60px;
}

/* ================= CARD ================= */

.skill-card{
    width:320px;
    background:#111;
    border-radius:20px;
    border:1px solid #333;
    padding:20px;
    transition:0.3s;
}

.skill-card:hover{
    transform:translateY(-5px);
}

/* HEADER */

.skill-title{
    display:block;
    text-align:center;
    cursor:pointer;
}

.skill-title:hover{
    color:#d59bf6;
}

.skill-toggle{
    display:none;
}

/* ================= CONTENT ================= */

.ac-list{
    display:none;
    margin-top:20px;
}

.skill-toggle:checked + .skill-title + .ac-list{
    display:block;
}

/* ================= EXPLANATION ================= */

.skill-explain{
    background:#181818;
    padding:15px;
    border-radius:12px;
    margin-bottom:15px;
    font-size:0.9rem;
    color:#ccc;
    line-height:1.5;
    border-left:3px solid #d59bf6;
}

/* ================= AC ================= */

.ac-item{
    background:#1a1a1a;
    padding:12px;
    border-radius:12px;
    margin-bottom:10px;
}

.ac-toggle{
    display:none;
}

.ac-label{
    cursor:pointer;
    display:block;
}

.ac-label:hover{
    color:#d59bf6;
}

/* SEMESTRE */

.sem-panel{
    display:none;
    margin-top:10px;
    text-align:center;
}

.ac-toggle:checked + label + .sem-panel{
    display:block;
}

/* BUTTONS */

.sem-btn{
    margin:5px;
    padding:6px 12px;
    border-radius:8px;
    border:none;
    cursor:pointer;
    background:#d59bf6;
    color:black;
    font-weight:500;
}

.sem-btn:hover{
    opacity:0.8;
}

/* ================= EXPERIENCE ================= */

.experience-container{
    display:flex;
    justify-content:center;
    gap:80px;
    align-items:flex-start;
    margin-top:60px;
    flex-wrap:wrap;
}

.exp-item{
    display:flex;
    gap:15px;
    margin-bottom:25px;
}

.exp-check{
    width:35px;
    height:35px;
    border-radius:50%;
    background:#d59bf6;
    display:flex;
    justify-content:center;
    align-items:center;
}

.exp-box{
    background:#1a1a1a;
    padding:15px 20px;
    border-radius:15px;
    width:300px;
}

.cv img{
    width:320px;
    border-radius:12px;
}

</style>


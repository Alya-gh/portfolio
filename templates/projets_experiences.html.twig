{% extends 'base.html.twig' %}

{% block body %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
:root{
    --bg:#0b0b0b;
    --card:#111;
    --card2:#151515;
    --border:#2a2a2a;
    --violet:#d59bf6;
    --text:#ffffff;
    --muted:#a9a9a9;
}

/* =====================
   GLOBAL
===================== */
.wrapper{
    background:var(--bg);
    color:var(--text);
    font-family:'DM Sans', Arial, sans-serif;
    line-height:1.7;
}

p{
    margin-bottom:12px;
    color:#ddd;
}

/* =====================
   TITRES SECTION
===================== */
.section-heading{
    text-align:center;
    margin:90px 0 40px;
    font-size:28px;
    font-weight:900;
    letter-spacing:1px;
}

.section-heading::after{
    content:"";
    display:block;
    width:80px;
    height:4px;
    background:var(--violet);
    margin:12px auto 0;
    border-radius:10px;
}

/* =====================
   SKILLS GRID → COLONNE 🔥
===================== */
.skills-grid{
    display:flex;
    flex-direction:column; /* 🔥 clé */
    align-items:center;
    gap:30px;
}

/* CARD */
.skill-card{
    width:100%;
    max-width:850px; /* 🔥 plus large et propre */
    background:var(--card);
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    transition:0.3s ease;
}

.skill-card:hover{
    transform:translateY(-6px);
    border-color:var(--violet);
    box-shadow:0 0 20px rgba(213,155,246,0.15);
}

/* toggle */
.skill-toggle{display:none;}

/* HEADER */
.skill-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:22px;
    cursor:pointer;
}

.skill-header:hover{
    color:var(--violet);
}

.skill-tag{
    font-size:11px;
    padding:4px 10px;
    border-radius:20px;
    border:1px solid var(--violet);
    color:var(--violet);
}

/* BODY */
.skill-body{
    display:none;
    padding:0 22px 22px;
}

.skill-toggle:checked ~ .skill-body{
    display:block;
}

.skill-body > *{
    margin-bottom:18px;
}

/* =====================
   SLIDER 🔥
===================== */
.slider{
    position:relative;
    width:100%;
    margin:20px 0;
}

.slider img{
    width:100%;
    border-radius:12px;
    border:1px solid var(--border);
    display:none;
}

.slider img.active{
    display:block;
}

/* boutons */
.slider-btn{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    background:rgba(0,0,0,0.6);
    border:none;
    color:white;
    font-size:18px;
    padding:8px 12px;
    cursor:pointer;
    border-radius:8px;
    transition:0.2s;
}

.slider-btn:hover{
    background:var(--violet);
    color:black;
}

.prev{ left:10px; }
.next{ right:10px; }

/* =====================
   PROOF BLOCK
===================== */
.proof-block{
    background:var(--card2);
    border-left:3px solid var(--violet);
    padding:15px;
    border-radius:12px;
}

.proof-title{
    font-weight:700;
    margin-bottom:10px;
    display:flex;
    align-items:center;
    gap:8px;
}

.proof-row{
    display:flex;
    flex-direction:column;
    gap:3px;
    margin-bottom:10px;
}

.proof-label{
    color:var(--violet);
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.proof-val{
    color:#ddd;
}

/* =====================
   GIBBS
===================== */
.gibbs-grid{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.gibbs-step{
    background:var(--card2);
    border-left:3px solid var(--violet);
    padding:14px;
    border-radius:10px;
    transition:0.2s;
}

.gibbs-step:hover{
    transform:translateX(4px);
}

.gibbs-label{
    color:var(--violet);
    font-weight:700;
    font-size:12px;
    margin-bottom:6px;
}

.gibbs-step p{
    font-size:14px;
    color:#ccc;
}

/* =====================
   AC
===================== */
.ac-section-title{
    font-weight:700;
    margin-bottom:10px;
}

.ac-item{
    background:var(--card2);
    border:1px solid var(--border);
    border-radius:12px;
    margin-top:10px;
    overflow:hidden;
}

.ac-toggle{display:none;}

.ac-label-row{
    display:flex;
    justify-content:space-between;
    padding:12px;
    cursor:pointer;
}

.ac-label-row:hover{
    color:var(--violet);
}

.sem-panel{
    display:none;
    padding:12px;
    text-align:center;
    background:#0f0f0f;
}

.ac-toggle:checked ~ .ac-label-row + .sem-panel{
    display:block;
}

.sem-btn{
    background:var(--violet);
    color:black;
    border:none;
    padding:6px 12px;
    margin:5px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

/* =====================
   AUTO EVAL
===================== */
.auto-eval{
    margin:70px auto;
    max-width:1100px;
    padding:10px;
}

.eval-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));
    gap:20px;
}

.eval-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    padding:22px;
    text-align:center;
    transition:0.3s;
}

.eval-card:hover{
    transform:translateY(-6px);
    border-color:var(--violet);
}

.comp-name{
    font-size:26px;
    font-weight:900;
    color:var(--violet);
}

.comp-title{
    font-size:12px;
    color:var(--muted);
    margin:10px 0 15px;
}

.stars{
    display:flex;
    justify-content:center;
    gap:5px;
    margin-bottom:10px;
}

.star{
    width:14px;
    height:14px;
    background:#333;
    border-radius:3px;
}

.star.on{
    background:var(--violet);
}

.eval-score{
    font-size:24px;
    font-weight:800;
}

/* =====================
   EXPERIENCE
===================== */
.exp-section{
    display:flex;
    justify-content:center;
    gap:60px;
    flex-wrap:wrap;
    align-items:flex-start;
}

.exp-list{
    display:flex;
    flex-direction:column;
    gap:15px;
}

.exp-item{
    display:flex;
    gap:12px;
    align-items:flex-start;
}

.exp-dot{
    width:36px;
    height:36px;
    background:var(--violet);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
}

.exp-box{
    background:var(--card);
    border:1px solid var(--border);
    padding:15px;
    border-radius:12px;
    width:280px;
    transition:0.3s;
}

.exp-box:hover{
    transform:translateY(-3px);
    border-color:var(--violet);
}

/* CV */
.cv-preview img{
    width:320px;
    border-radius:12px;
    border:1px solid var(--border);
}

/* =====================
   RESPONSIVE
===================== */
@media (max-width:768px){
    .exp-section{
        flex-direction:column;
        align-items:center;
    }
}
</style>

